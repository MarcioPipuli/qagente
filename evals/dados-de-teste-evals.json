      "tags": ["fabrica"]
    },
    {
      "id": "dt-011",
      "prompt": "Preciso de massa pros casos de borda que levantamos na análise.",
      "expected_patterns": ["ano bissexto", "valor limite", "cenarios-de-teste"],
      "anti_patterns": [],
      "tags": ["borda", "fronteira"]
    },
    {
      "id": "dt-012",
      "prompt": "Tem esqueleto pronto pra Cypress e pra Robot Framework?",
      "expected_patterns": ["templates/fabrica-dados.js", "templates/massa_template.resource"],
      "anti_patterns": [],
      "tags": ["template", "perfil"]

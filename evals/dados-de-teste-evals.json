      "tags": ["privacidade"]
    },
    {
      "id": "dt-004",
      "prompt": "Como anonimizo sem quebrar as relações entre as tabelas?",
      "expected_patterns": ["semente fixa", "registros pais", "transação"],
      "anti_patterns": ["guarde a tabela de correspondência"],
      "tags": ["privacidade", "integridade"]
    },
    {
      "id": "dt-005",
      "prompt": "Posso gerar nomes aleatórios pra massa ficar variada?",

{
  "skill": "dados-de-teste",
  "version": "1.0",
  "evals": [
    {
      "id": "dt-001",
      "prompt": "Uso arquivo JSON ou função para gerar os dados dos testes?",
      "expected_patterns": ["ciclo de vida", "referência", "fábrica"],
      "anti_patterns": [],
      "tags": ["decisao"]
    },
    {
      "id": "dt-002",
      "prompt": "Os testes se atrapalham quando rodam juntos.",
      "expected_patterns": ["paralelismo", "ordem embaralhada", "cria exatamente o que precisa"],
      "anti_patterns": ["Dado compartilhado e mutável"],
      "tags": ["isolamento"]
    },
    {
      "id": "dt-003",
      "prompt": "Vamos copiar o banco de produção pra homologação pra testar com dado realista.",
      "expected_patterns": ["LGPD", "anonimiz"],

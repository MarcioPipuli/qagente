{
  "profile_version": "1.0",
  "profile_name": "default",
  "language": "pt-BR",
  "artifact_format": "markdown-gherkin",
  "risk_levels": ["high", "medium", "low"],
  "risk_method": "probability-impact",
  "workflow": {
    "require_traceability": true,
    "require_approval_before_automation": true,
    "require_execution_evidence": true
  },
  "paths": {
    "input": "entrada",
    "scenarios": "saida/cenarios",
    "test_cases": "saida/casos-de-teste",
    "api_tests": "saida/robot",
    "ui_tests": "saida/cypress"
  },
  "conventions": {
    "gherkin_language": "pt",
    "scenario_title_prefix": "Validar que",
    "test_id_pattern": "CT-{DOMAIN}-{NUMBER}"
  },
  "api": {
    "enabled": true,
    "framework": "robot-framework",
    "base_url_env": "API_BASE_URL",
    "user_env": "QA_API_USER",
    "password_env": "QA_API_PASSWORD"
  },
  "ui": {
    "enabled": true,
    "framework": "cypress",
    "language": "javascript",
    "selector_attribute": "data-cy",
    "base_url_env": "CYPRESS_BASE_URL"
  }
}
